# Arquivo carregado quando NODE_ENV=test. Uso exclusivo em E2E — nunca
# commitar credenciais reais aqui. O banco `contratos_test` é criado
# por `npm run test:e2e:init` e isolado do dev.

DATABASE_URL="postgresql://contratos:contratos@localhost:5432/contratos_test?schema=public"

AUTH_SECRET="e2e-secret-not-for-production-use-only-in-test-environment-64-chars-plus"
AUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="e2e-secret-not-for-production-use-only-in-test-environment-64-chars-plus"
NEXTAUTH_URL="http://localhost:3001"

SEED_PASSWORD="E2ETest@2026!"

NEXT_PUBLIC_JFAP_UG_CODE="090037"

# Externos: mockados via page.route() nos fixtures — valores abaixo
# servem só para o cliente HTTP construir URLs parseáveis.
COMPRAS_DADOSABERTOS_BASE_URL="http://localhost:3002/dadosabertos"
MARITACA_API_KEY="mock-key-e2e"
MARITACA_BASE_URL="http://localhost:3002/maritaca"
MARITACA_MODEL="sabia-3.1"
MARITACA_MODEL_FILTER="sabiazinho-3"
MARITACA_MODEL_WRITER="sabia-3.1"

LOG_LEVEL="warn"

# Libera endpoints de suporte a E2E (ex.: /api/e2e/seed) no proxy.
# NUNCA definir em produção.
E2E_ENABLED="true"
