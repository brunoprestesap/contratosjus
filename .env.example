# Banco de dados
DATABASE_URL="postgresql://contratos:contratos@localhost:5432/contratos"

# Auth.js v5 (NextAuth)
AUTH_SECRET="gerar-com-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Compat (middleware)
NEXTAUTH_SECRET="mesmo-valor-de-AUTH_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# Seed (usado por: npx prisma db seed)
SEED_PASSWORD="trocar-antes-de-usar"

# Comprasnet (código UASG da JFAP)
NEXT_PUBLIC_JFAP_UG_CODE="090037"

# Comprasnet API autenticada (endpoints /api/v1/)
# CPF com pontos e traço: 111.111.111-11
COMPRASNET_CPF=""
COMPRASNET_PASSWORD=""

# PNCP (Portal Nacional de Contratações Públicas) — confirmar endpoints no Swagger oficial antes da Fase 3
PNCP_BASE_URL="https://pncp.gov.br/api/consulta"
PNCP_CIRCUIT_THRESHOLD="3"

# Maritaca AI (Sabiá) — provider de IA
# Obter chave em https://plataforma.maritaca.ai/
MARITACA_API_KEY=""
MARITACA_BASE_URL="https://chat.maritaca.ai/api"
MARITACA_MODEL="sabia-3.1"
MARITACA_MODEL_FILTER="sabiazinho-3"
MARITACA_MODEL_WRITER="sabia-3.1"

# Storage de PDFs gerados (Geração Documental)
# Omitir = padrão <projeto>/.data/documents (gravável em dev).
# Docker/produção: caminho absoluto, ex.: /var/jfap-contratos/documents
# DOCUMENTS_STORAGE_PATH="/var/jfap-contratos/documents"

# Ambiente
NODE_ENV="development"
