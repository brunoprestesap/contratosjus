# Banco de dados
DATABASE_URL="postgresql://contratos:contratos@localhost:5432/contratos"

# Auth.js v5 (NextAuth)
AUTH_SECRET="gerar-com-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Compat (middleware)
NEXTAUTH_SECRET="mesmo-valor-de-AUTH_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# Seed (usado por: npx prisma db seed)
SEED_PASSWORD="trocar-antes-de-usar"

# Comprasnet (código UASG da JFAP)
NEXT_PUBLIC_JFAP_UG_CODE="090037"

# Ambiente
NODE_ENV="development"
