# Template do ambiente de E2E. Copie para `.env.test` antes de rodar:
#
#   cp .env.test.example .env.test
#
# `.env.test` é ignorado pelo git (evita acidentes com `E2E_ENABLED=true`
# sendo copiado para produção). Cada dev mantém o seu local.

DATABASE_URL="postgresql://contratos:contratos@localhost:5432/contratos_test?schema=public"

# Gere um secret novo e local com:
#   openssl rand -base64 48
# Não reutilize este placeholder — rotacione antes do primeiro run.
AUTH_SECRET="REGENERATE_WITH_OPENSSL_RAND_BEFORE_USE"
AUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="REGENERATE_WITH_OPENSSL_RAND_BEFORE_USE"
NEXTAUTH_URL="http://localhost:3001"

SEED_PASSWORD="E2ETest@2026!"

NEXT_PUBLIC_JFAP_UG_CODE="090037"

# URLs apontam para o mock server HTTP que o Playwright sobe em beforeAll (porta 3002).
COMPRAS_DADOSABERTOS_BASE_URL="http://localhost:3002/dadosabertos"
MARITACA_API_KEY="mock-key-e2e"
MARITACA_BASE_URL="http://localhost:3002/maritaca"
MARITACA_MODEL="sabia-3.1"
MARITACA_MODEL_FILTER="sabiazinho-3"
MARITACA_MODEL_WRITER="sabia-3.1"

LOG_LEVEL="warn"

# Libera endpoints de suporte a E2E (ex.: /api/e2e/seed) no proxy.
# NUNCA definir em produção — o gate verifica literalmente "true".
E2E_ENABLED="true"
